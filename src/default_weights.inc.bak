// Default evaluation weights - standard PST values for each piece type
// Layout: PSQT (6 types x 64 squares), mobility, pawn features, king safety
// All values in centipawns from the piece's perspective (mirrored for black)
// A1=0, B1=1, ..., H1=7, A2=8, ..., H8=63

// PAWN PSQT (0-63) - row 0 (rank 1) to row 7 (rank 8)
// Row 0 = back rank (pawns don't belong here)
  0,  0,  0,  0,  0,  0,  0,  0,
// Row 1 = starting rank
  0,  0,  0,  0,  0,  0,  0,  0,
// Row 2 = 3rd rank (slightly advanced)
 10, 10, 15, 20, 20, 15, 10, 10,
// Row 3 = 4th rank (center control)
 15, 15, 25, 35, 35, 25, 15, 15,
// Row 4 = 5th rank (advanced)
 20, 25, 35, 45, 45, 35, 25, 20,
// Row 5 = 6th rank (very advanced)
 30, 35, 45, 55, 55, 45, 35, 30,
// Row 6 = 7th rank (near promotion)
 60, 65, 75, 85, 85, 75, 65, 60,
// Row 7 = promotion rank
  0,  0,  0,  0,  0,  0,  0,  0,

// KNIGHT PSQT (64-127)
// Row 0
-50,-40,-30,-30,-30,-30,-40,-50,
// Row 1
-40,-20,  0,  5,  5,  0,-20,-40,
// Row 2
-30,  5, 20, 25, 25, 20,  5,-30,
// Row 3
-30, 10, 30, 35, 35, 30, 10,-30,
// Row 4
-30, 10, 30, 35, 35, 30, 10,-30,
// Row 5
-30,  5, 20, 25, 25, 20,  5,-30,
// Row 6
-40,-10, 10, 15, 15, 10,-10,-40,
// Row 7
-50,-40,-30,-25,-25,-30,-40,-50,

// BISHOP PSQT (128-191)
-20,-10,-10,-10,-10,-10,-10,-20,
-10,  5,  5,  5,  5,  5,  5,-10,
-10, 10, 15, 15, 15, 15, 10,-10,
-10, 15, 20, 20, 20, 20, 15,-10,
-10, 15, 20, 25, 25, 20, 15,-10,
-10, 10, 15, 20, 20, 15, 10,-10,
-10,  5, 10, 10, 10, 10,  5,-10,
-20,-10,-10,-10,-10,-10,-10,-20,

// ROOK PSQT (192-255)
  0,  0,  5, 10, 10,  5,  0,  0,
  5, 10, 15, 20, 20, 15, 10,  5,
  0,  5, 10, 15, 15, 10,  5,  0,
  0,  5, 10, 15, 15, 10,  5,  0,
  0,  5,  5, 10, 10,  5,  5,  0,
  0,  0,  5, 10, 10,  5,  0,  0,
  0,  0,  0,  5,  5,  0,  0,  0,
  5,  5, 10, 15, 15, 10,  5,  5,

// QUEEN PSQT (256-319)
-20,-10,-10, -5, -5,-10,-10,-20,
-10,  0,  0,  0,  0,  0,  0,-10,
-10,  5, 10, 10, 10, 10,  5,-10,
 -5,  5, 10, 15, 15, 10,  5, -5,
  0,  5, 10, 15, 15, 10,  5,  0,
-10,  5, 10, 15, 15, 10,  5,-10,
-10,  0,  5,  5,  5,  5,  0,-10,
-20,-10,-10, -5, -5,-10,-10,-20,

// KING PSQT (320-383) - opening/middlegame (king should be safe)
 20, 30, 10,  0,  0, 10, 30, 20,
 20, 20,  0,  0,  0,  0, 20, 20,
-10,-20,-20,-20,-20,-20,-20,-10,
-20,-30,-30,-40,-40,-30,-30,-20,
